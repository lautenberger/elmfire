&INPUTS
FUELS_AND_TOPOGRAPHY_DIRECTORY = './data/inputs'
ASP_FILENAME                   = 'asp'
CBD_FILENAME                   = 'cbd'
CBH_FILENAME                   = 'cbh'
CC_FILENAME                    = 'cc'
CH_FILENAME                    = 'ch'
DEM_FILENAME                   = 'dem'
FBFM_FILENAME                  = 'fbfm40'
SLP_FILENAME                   = 'slp'
ADJ_FILENAME                   = 'adj'
PHI_FILENAME                   = 'phi'
DT_METEOROLOGY                 = 3600.0
WEATHER_DIRECTORY              = './data/inputs'
WS_FILENAME                    = 'ws'
WD_FILENAME                    = 'wd'
M1_FILENAME                    = 'm1'
M10_FILENAME                   = 'm10'
M100_FILENAME                  = 'm100'
/

&OUTPUTS
OUTPUTS_DIRECTORY    = './data/outputs'
DTDUMP = 1.0
DUMP_PHI             = .TRUE.
DUMP_FLIN            = .TRUE.
DUMP_SPREAD_RATE     = .TRUE.
SPREAD_RATE_IN_M     = .TRUE.
DUMP_TIME_OF_ARRIVAL = .TRUE.
DUMP_SURFACE_FIRE    = .TRUE.
CONVERT_TO_GEOTIFF   = .TRUE.
/

&TIME_CONTROL
SIMULATION_TSTART = 0.0
SIMULATION_TSTOP = 10.0
SIMULATION_DT = 1.0
SIMULATION_DTMAX = 1.0
/

&SIMULATOR
NUM_IGNITIONS = 1
X_IGN(1)      = 0.0
Y_IGN(1)      = 0.0
T_IGN(1)      = 0.0
BANDTHICKNESS = 1
/

&MISCELLANEOUS
PATH_TO_GDAL                   = 'auto'
SCRATCH                        = './data/scratch'
/
