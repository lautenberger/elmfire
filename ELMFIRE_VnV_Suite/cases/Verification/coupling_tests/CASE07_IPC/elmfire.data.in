&INPUTS
FUELS_AND_TOPOGRAPHY_DIRECTORY='./data/inputs'
ASP_FILENAME='asp'
CBD_FILENAME='cbd'
CBH_FILENAME='cbh'
CC_FILENAME='cc'
CH_FILENAME='ch'
DEM_FILENAME='dem'
FBFM_FILENAME='new_fbfm40'
SLP_FILENAME='slp'
ADJ_FILENAME='adj'
PHI_FILENAME='new_phi'
WEATHER_DIRECTORY='./data/inputs'
WS_FILENAME='ws'
WD_FILENAME='wd'
M1_FILENAME='m1'
M10_FILENAME='m10'
M100_FILENAME='m100'
DT_METEOROLOGY=3600.0
DEAD_MC_IN_PERCENT=.TRUE.
LIVE_MC_IN_PERCENT=.TRUE.
USE_CONSTANT_LH=.TRUE.
USE_CONSTANT_LW=.TRUE.
USE_CONSTANT_FMC=.TRUE.
FOLIAR_MOISTURE_CONTENT=0.01
LH_MOISTURE_CONTENT=30
LW_MOISTURE_CONTENT=60
/

&OUTPUTS
OUTPUTS_DIRECTORY='./outputs'
DTDUMP=20.0
DUMP_FLIN=.FALSE.
DUMP_SPREAD_RATE=.FALSE.
DUMP_TIME_OF_ARRIVAL=.TRUE.
CONVERT_TO_GEOTIFF=.TRUE.
DUMP_TIMINGS=.TRUE.
DUMP_PHI=.FALSE.
DUMP_EMBER_FLUX=.FALSE.
DUMP_EMBER_FLUX_TRANSIENT=.FALSE.
DUMP_EMBER_IGNITION=.FALSE.
DUMP_SPOTTING_OUTPUTS=.FALSE.
/

&TIME_CONTROL
SIMULATION_DT=0.74515648
SIMULATION_DTMAX=20.0
TARGET_CFL=0.45
SIMULATION_TSTOP=240.0
/

&SIMULATOR
BANDTHICKNESS=3
NUM_IGNITIONS=0
UNTAG_TYPE_2=.FALSE.
UNTAG_TYPE_3=.FALSE.
WIND_FLUCTUATIONS=.FALSE.
RANDOMIZE_RANDOM_SEED=.FALSE.
/

&MONTE_CARLO
NUM_ENSEMBLE_MEMBERS=1
SEED=51400
/

&SPOTTING
ENABLE_SPOTTING=.TRUE.
ENABLE_SURFACE_FIRE_SPOTTING=.TRUE.
! ELMFIRE allocates and writes eight spotting Monte Carlo coefficients whenever
! spotting is enabled. Exercise that initialization path, but pin every bound
! below so no spotting-model parameter is actually perturbed.
STOCHASTIC_SPOTTING=.TRUE.
USE_SUPERSEDED_SPOTTING=.FALSE.
GENERATION_MODEL='PER-AREA'
SPOTTING_DISTANCE_MODEL='EMPIRICAL'
ACCUMULATION_MODEL='EULERIAN'
IGNITION_MODEL='SIMPLE'
USE_PHYSICAL_SPOTTING_DURATION=.FALSE.
TAU_EMBERGEN=10.0
NO_SURFACE_FIRE=.TRUE.
USE_EMBER_CONSUMPTION=.FALSE.
USE_CUSTOMIZED_PDF=.TRUE.
USE_CROSSWIND_DISTRIBUTION=.FALSE.
MU_DOWNWIND=2.18
SIGMA_DOWNWIND=1.23
EMBER_GR=10.0 ! firebrands m^-2 s^-1
P_EPS=0.01
MEAN_SPOTTING_DIST=0.0
MEAN_SPOTTING_DIST_MIN=0.0
MEAN_SPOTTING_DIST_MAX=0.0
NORMALIZED_SPOTTING_DIST_VARIANCE=0.0
NORMALIZED_SPOTTING_DIST_VARIANCE_MIN=0.0
NORMALIZED_SPOTTING_DIST_VARIANCE_MAX=0.0
SPOT_WS_EXP=0.9
SPOT_WS_EXP_LO=0.9
SPOT_WS_EXP_HI=0.9
SPOT_FLIN_EXP=0.5
SPOT_FLIN_EXP_LO=0.5
SPOT_FLIN_EXP_HI=0.5
NEMBERS_MAX=1
NEMBERS_MAX_LO=1
NEMBERS_MAX_HI=1
GLOBAL_SURFACE_FIRE_SPOTTING_PERCENT=100.0
GLOBAL_SURFACE_FIRE_SPOTTING_PERCENT_MIN=100.0
GLOBAL_SURFACE_FIRE_SPOTTING_PERCENT_MAX=100.0
CROWN_FIRE_SPOTTING_PERCENT=100.0
CROWN_FIRE_SPOTTING_PERCENT_MIN=100.0
CROWN_FIRE_SPOTTING_PERCENT_MAX=100.0
PIGN_MIN=90.0
PIGN=90.0
PIGN_MAX=90.0
LOCAL_IGNITION_TIME=10.0
CELL_IGNITION_DELAY=0.0
/

&WUI
USE_BLDG_SPREAD_MODEL=.FALSE.
/

&MISCELLANEOUS
MISCELLANEOUS_INPUTS_DIRECTORY='./data/misc'
FUEL_MODEL_FILE='fuel_models.csv'
BUILDING_FUEL_MODEL_FILE='building_fuel_models.csv'
PATH_TO_GDAL='auto'
SCRATCH='./logs/scratch'
/
