&INPUTS
SURFACE_SPREAD_MODEL = 'ROTHERMEL'
@VARIANT_INPUT_DIRECTORIES@
ASP_FILENAME = 'asp'
CBD_FILENAME = 'cbd'
CBH_FILENAME = 'cbh'
CC_FILENAME = 'cc'
CH_FILENAME = 'ch'
DEM_FILENAME = 'dem'
FBFM_FILENAME = 'fbfm40'
SLP_FILENAME = 'slp'
ADJ_FILENAME = 'adj'
PHI_FILENAME = 'phi'
BLDG_AREA_FILENAME = 'bldg_area'
BLDG_SEPARATION_DIST_FILENAME = 'bldg_separation'
BLDG_NONBURNABLE_FRAC_FILENAME = 'bldg_nonburnable'
BLDG_FOOTPRINT_FRAC_FILENAME = 'bldg_footprint'
BLDG_FUEL_MODEL_FILENAME = 'bldg_fuel_model'
DT_METEOROLOGY = 3600.0
WS_FILENAME = 'ws'
WD_FILENAME = 'wd'
M1_FILENAME = 'm1'
M10_FILENAME = 'm10'
M100_FILENAME = 'm100'
DEAD_MC_IN_PERCENT = .TRUE.
LIVE_MC_IN_PERCENT = .TRUE.
USE_CONSTANT_LH = .TRUE.
LH_MOISTURE_CONTENT = 60.0
USE_CONSTANT_LW = .TRUE.
LW_MOISTURE_CONTENT = 90.0
USE_CONSTANT_FMC = .TRUE.
FOLIAR_MOISTURE_CONTENT = 90.0
/

&OUTPUTS
@VARIANT_OUTPUT_DIRECTORY@
DTDUMP = 60.0
DUMP_HRR_TRANSIENT = .TRUE.
DUMP_TRANSIENT_DFC = .TRUE.
DUMP_TRANSIENT_RAD = .TRUE.
DUMP_TOTAL_DFC_RECEIVED = .FALSE.
DUMP_TOTAL_RAD_RECEIVED = .FALSE.
DUMP_TIME_OF_ARRIVAL = .TRUE.
DUMP_PHI = .FALSE.
CONVERT_TO_GEOTIFF = .TRUE.
/

&TIME_CONTROL
SIMULATION_TSTART = 0.0
SIMULATION_TSTOP = 120.0
SIMULATION_DT = 1.0
SIMULATION_DTMAX = 1.0
TARGET_CFL = 0.2
/

&SIMULATOR
BANDTHICKNESS = 3
WIND_FLUCTUATIONS = .FALSE.
RANDOMIZE_RANDOM_SEED = .FALSE.
NUM_IGNITIONS = 1
@VARIANT_DORMANT_IGNITION@
T_IGN(1) = 121.0
/

&SPOTTING
ENABLE_SPOTTING = .FALSE.
ENABLE_SURFACE_FIRE_SPOTTING = .FALSE.
/

&WUI
BLDG_FUEL_MODEL_CONSTANT = 1
BLDG_SPREAD_MODEL_TYPE = 2
USE_BLDG_SPREAD_MODEL = .TRUE.
INTERFACE_MODEL_TYPE = 1
BANDTHICKNESS_WUI = 24
CRITICL_HF_WUI = 0.0
HRR_ELLIPSE_ADJ = 1.0
@VARIANT_BUILDING_PARAMETERS@
/

&MISCELLANEOUS
MISCELLANEOUS_INPUTS_DIRECTORY = './data/misc/'
FUEL_MODEL_FILE = 'fuel_models.csv'
BUILDING_FUEL_MODEL_FILE = 'building_fuel_models.csv'
PATH_TO_GDAL = 'auto'
@VARIANT_SCRATCH_DIRECTORY@
/
