&INPUTS
FUELS_AND_TOPOGRAPHY_DIRECTORY='./data/inputs/'
ASP_FILENAME='asp'
CBD_FILENAME='cbd'
CBH_FILENAME='cbh'
CC_FILENAME='cc'
CH_FILENAME='ch'
DEM_FILENAME='dem'
FBFM_FILENAME='fbfm'
SLP_FILENAME='slp'
ADJ_FILENAME='adj'
PHI_FILENAME='phi'
WEATHER_DIRECTORY='./data/inputs/'
WS_FILENAME='ws'
WD_FILENAME='wd'
M1_FILENAME='m1'
M10_FILENAME='m10'
M100_FILENAME='m100'
DT_METEOROLOGY=3600.0
DEAD_MC_IN_PERCENT=.TRUE.
LIVE_MC_IN_PERCENT=.TRUE.
USE_CONSTANT_LH=.TRUE.
USE_CONSTANT_LW=.TRUE.
USE_CONSTANT_FMC=.TRUE.
FOLIAR_MOISTURE_CONTENT=0.01
LH_MOISTURE_CONTENT=30.0
LW_MOISTURE_CONTENT=60.0
SURFACE_SPREAD_MODEL='ROTHERMEL'
/

&OUTPUTS
OUTPUTS_DIRECTORY='./outputs/'
DTDUMP=30.0
DUMP_EVERY_STEP=.FALSE.
DUMP_PHI=.TRUE.
DUMP_VELOCITY=.TRUE.
DUMP_SPREAD_RATE=.TRUE.
SPREAD_RATE_IN_M=.TRUE.
DUMP_TIME_OF_ARRIVAL=.TRUE.
DUMP_TOTAL_DFC_RECEIVED=.TRUE.
DUMP_TOTAL_RAD_RECEIVED=.TRUE.
DUMP_TRANSIENT_DFC=.FALSE.
DUMP_TRANSIENT_RAD=.FALSE.
DUMP_HRR_TRANSIENT=.FALSE.
DUMP_TIMINGS=.TRUE.
CONVERT_TO_GEOTIFF=.TRUE.
/

&TIME_CONTROL
SIMULATION_TSTART=0.0
SIMULATION_TSTOP=300.0
SIMULATION_DT=0.25
SIMULATION_DTMAX=0.25
TARGET_CFL=0.45
/

&SIMULATOR
BANDTHICKNESS=3
FEEDBACK_LEVEL=1
NUM_IGNITIONS=1
X_IGN(1)=10.0
Y_IGN(1)=20.0
T_IGN(1)=@DORMANT_IGNITION_TIME@
UNTAG_TYPE_2=.FALSE.
UNTAG_TYPE_3=.FALSE.
WIND_FLUCTUATIONS=.FALSE.
RANDOMIZE_RANDOM_SEED=.FALSE.
CROWN_FIRE_MODEL=0
/

&MONTE_CARLO
NUM_ENSEMBLE_MEMBERS=1
SEED=48001
/

&SPOTTING
ENABLE_SPOTTING=.FALSE.
NO_SURFACE_FIRE=.FALSE.
/

&WUI
BLDG_AREA_CONSTANT=20.0
BLDG_SEPARATION_DIST_CONSTANT=10.0
BLDG_NONBURNABLE_FRAC_CONSTANT=0.0
BLDG_FOOTPRINT_FRAC_CONSTANT=1.0
BLDG_FUEL_MODEL_CONSTANT=14
BLDG_SPREAD_MODEL_TYPE=2
USE_BLDG_SPREAD_MODEL=.TRUE.
USE_CONSTANT_BLDG_SPREAD_MODEL_PARAMS=.TRUE.
BANDTHICKNESS_WUI=@BANDTHICKNESS_WUI@
CRITICL_HF_WUI=0.0
HRR_ELLIPSE_ADJ=0.5
/

&MISCELLANEOUS
MISCELLANEOUS_INPUTS_DIRECTORY='./data/misc/'
FUEL_MODEL_FILE='fuel_models.csv'
BUILDING_FUEL_MODEL_FILE='building_fuel_models.csv'
PATH_TO_GDAL='auto'
SCRATCH='./logs/scratch/'
/
