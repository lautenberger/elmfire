CBH_FILENAME = 'cbh'
CC_FILENAME = 'cc'
CH_FILENAME = 'ch'
CC_IN_PERCENT = .TRUE.
CH_TIMES_10 = .TRUE.
DEM_FILENAME = 'dem'
FBFM_FILENAME = 'fbfm40'
SLP_FILENAME = 'slp'
ADJ_FILENAME = 'adj'
PHI_FILENAME = 'phi'
WEATHER_DIRECTORY = './variants/template/inputs'
