&INPUTS
FUELS_AND_TOPOGRAPHY_DIRECTORY='./data/inputs'
ASP_FILENAME='asp'
CBD_FILENAME='cbd'
CBH_FILENAME='cbh'
CC_FILENAME='cc'
CH_FILENAME='ch'
DEM_FILENAME='dem'
FBFM_FILENAME='new_fbfm40'
SLP_FILENAME='slp'
ADJ_FILENAME='adj'
PHI_FILENAME='new_phi'
WEATHER_DIRECTORY='./data/inputs'
WS_FILENAME='ws'
WD_FILENAME='wd'
M1_FILENAME='m1'
M10_FILENAME='m10'
M100_FILENAME='m100'
DT_METEOROLOGY=3600.0
DEAD_MC_IN_PERCENT=.TRUE.
LIVE_MC_IN_PERCENT=.TRUE.
USE_CONSTANT_LH=.TRUE.
USE_CONSTANT_LW=.TRUE.
USE_CONSTANT_FMC=.TRUE.
FOLIAR_MOISTURE_CONTENT=0.01
LH_MOISTURE_CONTENT=30
LW_MOISTURE_CONTENT=60
/

&OUTPUTS
OUTPUTS_DIRECTORY='./outputs'
DUMP_EVERY_STEP= .TRUE.
DUMP_FLIN=.TRUE.
DUMP_SPREAD_RATE=.TRUE.
DUMP_TIME_OF_ARRIVAL=.TRUE.
CONVERT_TO_GEOTIFF=.TRUE.
DUMP_TIMINGS=.TRUE.
DUMP_PHI=.TRUE.
DUMP_EMBER_FLUX=.TRUE.
DUMP_EMBER_FLUX_TRANSIENT=.TRUE.
DUMP_EMBER_IGNITION=.TRUE.
DUMP_SPOTTING_OUTPUTS=.TRUE.
DUMP_HRR_TRANSIENT=.TRUE.
DUMP_TRANSIENT_DFC=.TRUE.
DUMP_TRANSIENT_RAD=.TRUE.
DUMP_TOTAL_DFC_RECEIVED=.TRUE.
DUMP_TOTAL_RAD_RECEIVED=.TRUE.
/

&TIME_CONTROL
SIMULATION_DT=0.74515648
SIMULATION_DTMAX=0.74515648
TARGET_CFL=0.45
SIMULATION_TSTOP=500
/

&SIMULATOR
BANDTHICKNESS=3
NUM_IGNITIONS=1
X_IGN(1)=5.0
Y_IGN(1)=25.0
UNTAG_TYPE_2=.FALSE.
UNTAG_TYPE_3=.FALSE.
WIND_FLUCTUATIONS=.FALSE.
RANDOMIZE_RANDOM_SEED=.FALSE.
/

&SPOTTING
GENERATION_MODEL     = 'PER-AREA'
SPOTTING_DISTANCE_MODEL = 'EMPIRICAL'
ACCUMULATION_MODEL   = 'EULERIAN'
IGNITION_MODEL       = 'DIRECT' 

ENABLE_SPOTTING=.TRUE.
ENABLE_SURFACE_FIRE_SPOTTING=.TRUE.
USE_SUPERSEDED_SPOTTING=.FALSE.
USE_PHYSICAL_SPOTTING_DURATION=.FALSE.
NO_SURFACE_FIRE=.TRUE.
USE_EMBER_CONSUMPTION=.FALSE.
USE_CUSTOMIZED_PDF=.TRUE.
USE_CROSSWIND_DISTRIBUTION=.FALSE.
MU_DOWNWIND=2.18
SIGMA_DOWNWIND=1.23
EMBER_GR=10.0
EMBER_GR_PER_MW_VEGE=3.33
EMBER_GR_PER_MW_BLDG=1.0
LOCAL_IGNITION_TIME=0.0
CELL_IGNITION_DELAY=0.0
PIGN=100.0 ! percent; unity direct-ignition probability
/

&WUI
BLDG_AREA_CONSTANT=10.0
BLDG_SEPARATION_DIST_CONSTANT=10.0
BLDG_NONBURNABLE_FRAC_CONSTANT=0.0
BLDG_FOOTPRINT_FRAC_CONSTANT=1.0
BLDG_FUEL_MODEL_CONSTANT=14
BLDG_SPREAD_MODEL_TYPE=2
USE_BLDG_SPREAD_MODEL=.FALSE.
USE_CONSTANT_BLDG_SPREAD_MODEL_PARAMS=.TRUE.
BANDTHICKNESS_WUI=5
CRITICL_HF_WUI=0.0
/

&MISCELLANEOUS
MISCELLANEOUS_INPUTS_DIRECTORY='./data/misc'
FUEL_MODEL_FILE='fuel_models.csv'
BUILDING_FUEL_MODEL_FILE='building_fuel_models.csv'
PATH_TO_GDAL='auto'
SCRATCH='./logs/scratch'
/
