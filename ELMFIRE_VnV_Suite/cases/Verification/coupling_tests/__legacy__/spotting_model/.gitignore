# macOS metadata
.DS_Store
**/.DS_Store

# Python bytecode generated while running pre/postprocessors
__pycache__/
**/__pycache__/
*.py[cod]

# Case input rasters generated by preprocessing
**/data/inputs/

# Parametric variants generated by preprocessing
**/variants/manifest.json
**/variants/*/elmfire.data.in
**/variants/*/data/
**/variants/*/outputs/
**/variants/*/logs/
**/variants/*/figures/*
!**/variants/*/figures/*.pdf

# Simulation and postprocessing products
**/outputs/
**/logs/
**/figures/*
!**/figures/*.pdf
**/report/metrics_macros.tex

# LaTeX scratch files (compiled PDF documents remain tracked)
**/report/*.aux
**/report/*.bbl
**/report/*.bcf
**/report/*.blg
**/report/*.fdb_latexmk
**/report/*.fls
**/report/*.lof
**/report/*.log
**/report/*.lot
**/report/*.nav
**/report/*.out
**/report/*.run.xml
**/report/*.snm
**/report/*.synctex.gz
**/report/*.toc
**/report/*.vrb
**/report/*.xdv
**/report/_minted-*/
