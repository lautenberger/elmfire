CBD_FILENAME = 'cbd'
CBH_FILENAME = 'cbh'
CC_FILENAME = 'cc'
CH_FILENAME = 'ch'
DEM_FILENAME = 'dem'
FBFM_FILENAME = 'fbfm40'
SLP_FILENAME = 'slp'
ADJ_FILENAME = 'adj'
PHI_FILENAME = 'phi'
DT_METEOROLOGY = 3600.0
WEATHER_DIRECTORY = '@INPUT_DIR@'
WS_FILENAME = 'ws'
WD_FILENAME = 'wd'
WS_AT_10M = .FALSE.
WS_IN_KPH = .FALSE.
M1_FILENAME = 'm1'
M10_FILENAME = 'm10'
M100_FILENAME = 'm100'
DEAD_MC_IN_PERCENT = .FALSE.
LIVE_MC_IN_PERCENT = .FALSE.
USE_CONSTANT_LH = .TRUE.
LH_MOISTURE_CONTENT = 0.60
USE_CONSTANT_LW = .TRUE.
LW_MOISTURE_CONTENT = 0.90
