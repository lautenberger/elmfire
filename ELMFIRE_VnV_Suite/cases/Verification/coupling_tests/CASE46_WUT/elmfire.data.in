FOLIAR_MOISTURE_CONTENT = 0.90
/

&OUTPUTS
OUTPUTS_DIRECTORY = '@OUTPUT_DIR@'
DTDUMP = 1.0
DUMP_EVERY_STEP = .TRUE.
DUMP_FLIN = .TRUE.
DUMP_SPREAD_RATE = .TRUE.
SPREAD_RATE_IN_M = .TRUE.
DUMP_TIME_OF_ARRIVAL = .TRUE.
DUMP_PHI = .TRUE.
DUMP_TAGGED = .TRUE.
DUMP_SURFACE_FIRE = .TRUE.
DUMP_HRR_TRANSIENT = .TRUE.
DUMP_TRANSIENT_DFC = .TRUE.
DUMP_TRANSIENT_RAD = .TRUE.
CONVERT_TO_GEOTIFF = .TRUE.
/

&TIME_CONTROL
SIMULATION_TSTART = 0.0
SIMULATION_TSTOP = 60.0
SIMULATION_DT = 1.0
SIMULATION_DTMAX = 1.0
TARGET_CFL = 0.10
/

&SIMULATOR
FEEDBACK_LEVEL = 1
NUM_IGNITIONS = 1
X_IGN(1) = 0.0
Y_IGN(1) = 0.0
T_IGN(1) = 61.0
BANDTHICKNESS = 3
WIND_FLUCTUATIONS = .FALSE.
RANDOMIZE_RANDOM_SEED = .FALSE.
CROWN_FIRE_MODEL = 0
/

&SPOTTING
ENABLE_SPOTTING = .FALSE.
ENABLE_SURFACE_FIRE_SPOTTING = .FALSE.
/

&WUI
BLDG_AREA_CONSTANT = 20.0
BLDG_SEPARATION_DIST_CONSTANT = 10.0
